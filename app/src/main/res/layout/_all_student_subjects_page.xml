<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include layout="@layout/_background" />

    <TextView
        android:id="@+id/title_texView"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="187dp"
        android:fontFamily="@font/poppins"
        android:gravity="center|center_horizontal|center_vertical"
        android:text="Wybierz zajęcia"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/all_subjects"
        android:layout_width="173dp"
        android:layout_height="25dp"
        android:layout_marginStart="17dp"
        android:layout_marginTop="247dp"
        android:background="@color/background_color"
        android:fontFamily="@font/poppins_semibold"
        android:text="Pokaż wszystkie"
        android:textColor="#313131"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/choose_date"
        android:layout_width="123dp"
        android:layout_height="20dp"
        android:layout_marginTop="247dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="21dp"
        android:background="@color/background_color"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="right"
        android:text="Wybierz datę"
        android:textColor="#313131"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/scroll_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scroll_list"
        android:layout_width="374dp"
        android:layout_height="0dp"
        android:layout_marginStart="9dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/_white_rectangle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/all_subjects"
        app:layout_constraintBottom_toTopOf="@+id/add_group_button">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/add_group_button"
        android:layout_width="346dp"
        android:layout_height="70dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="23dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/_green_big_button"
        android:fontFamily="@font/poppins_semibold"
        android:text="Dołącz do nowej grupy"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@id/return_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <Button
        android:id="@+id/return_button"
        android:layout_width="346dp"
        android:layout_height="70dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="23dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/_gray_button_background"
        android:fontFamily="@font/poppins_semibold"
        android:text="Powrót"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>