<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEAC2"
    tools:context=".Student.ShowActivityPlot">

    <TextView
        android:id="@+id/subject"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        android:text=""
        android:textSize="50sp"
        android:textColor="#000000"
        android:gravity="center" />

    <com.jjoe64.graphview.GraphView
        android:id="@+id/activity_plot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.388"
        app:layout_constraintTop_toBottomOf="@+id/subject"
        app:layout_constraintBottom_toTopOf="@+id/activity_buttons_layouts"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"/>

    <LinearLayout
        android:id="@+id/activity_buttons_layouts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        app:layout_constraintBottom_toTopOf="@+id/return_button_layout"
        android:layout_marginBottom="15dp"
        >

        <Button
            android:id="@+id/group_button"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/button_background"
            android:text="Grupa"
            android:textColor="#FFFFFF"
            android:textSize="20sp"

            app:layout_constraintEnd_toStartOf="@+id/plot_button"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.231"
            />

        <Button
            android:id="@+id/ranking_button"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:background="@drawable/button_background"
            android:text="Ranking"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@+id/activityView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@id/ranking_button"
            app:layout_constraintVertical_bias="0.231"
            />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/return_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center_horizontal"
        android:layout_marginBottom="35dp"
        >

        <Button
            android:id="@+id/return_button"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:background="@drawable/button_background"
            android:text="Powrót"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_bias="0.231"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>